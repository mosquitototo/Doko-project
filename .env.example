POSTGRES_DB=doko
POSTGRES_USER=doko_user
POSTGRES_PASSWORD="change_me"
POSTGRES_HOST=db
POSTGRES_PORT=5432

DOKO_HTTP_BIND=127.0.0.1
DOKO_HTTP_PORT=8080

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace_with_a_unique_random_value_of_at_least_32_characters
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_COOKIE_SECURE=0
DJANGO_ALLOWED_HOSTS=doko.example.com,localhost,127.0.0.1

### remove http://localhost:8080,http://127.0.0.1:8080 for prod, then docker compose restart web nginx
DJANGO_CSRF_TRUSTED_ORIGINS=https://doko.example.com,http://localhost:8080,http://127.0.0.1:8080
DJANGO_CORS_ALLOWED_ORIGINS=https://doko.example.com,http://localhost:8080,http://127.0.0.1:8080

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=300

### Optional: backup directory inside the persistent doko_media volume
# DOKO_BACKUP_DIR=/app/media/backups

DOKO_ADMIN_USERNAME=admin
DOKO_ADMIN_EMAIL=admin@local
### Optional: when omitted, the initial password is generated and printed once in doko-web logs
# DOKO_ADMIN_PASSWORD=

### Optional: derived automatically from DJANGO_SECRET_KEY when omitted
# CONNECTOR_HMAC_SECRET=
